   const rc=roomCode(),p={...me,name:name.trim()||"Spieler 1"};setMe(p);setHost(true);
   const r={code:rc,status:"lobby",questions:shuffle(QUESTIONS).slice(0,15)};setCode(rc);setRoom(r);setPlayers([p]);localStorage.setItem(`room-${rc}`,JSON.stringify(r));localStorage.setItem(`wr-${rc}`,JSON.stringify([p]));connect(rc,true);setScreen("lobby");
 }
 function join(){
   const rc=code.trim(),p={...me,name:name.trim()||"Gast"};setMe(p);setHost(false);connect(rc,false);
   const cached=JSON.parse(localStorage.getItem(`room-${rc}`)||"null");if(cached){setRoom(cached);setPlayers(JSON.parse(localStorage.getItem(`wr-${rc}`)||"[]"));setScreen("lobby")}post("join",p);setTimeout(()=>post("join",p),150);
 }
 function start(){const r={...room,status:"game"};setRoom(r);localStorage.setItem(`room-${room.code}`,JSON.stringify(r));setScreen("game");setTime(15);startAt.current=Date.now();post("start",r)}
 function submit(i){if(locked)return;setSelected(i);setLocked(true);const elapsed=Math.min(15000,Date.now()-startAt.current);const payload={id:me.id,index:i,elapsed,correct:i===question.c};setAnswers(a=>({...a,[me.id]:payload}));post("answer",payload);if(i!==question.c)setMood("sad")}
 function scoreRound(){
   const correct=Object.values(answers).filter(x=>x.correct).sort((a,b)=>a.elapsed-b.elapsed);const bonus=[1000,700,500];
   const ps=players.map(p=>{const rank=correct.findIndex(x=>x.id===p.id);return {...p,score:p.score+(rank>=0?(bonus[rank]||250)+Math.max(0,Math.round((15000-correct[rank].elapsed)/50)):0)}});
   savePlayers(ps);post("scores",{players:ps,correctIds:correct.map(x=>x.id)})
 }
 function next(){const done=round>=room.questions.length-1;const data={done,round:round+1,players};post("next",data);if(done)setScreen("result");else{setRound(x=>x+1);setSelected(null);setLocked(false);setAnswers({});setMood("normal");setTime(15);startAt.current=Date.now()}}
