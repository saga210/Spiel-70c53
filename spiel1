  {screen==="game"&&question&&<div className="grid lg:grid-cols-[1fr_280px] gap-5"><section><div className="flex justify-between items-center mb-4"><span className="bg-white/10 px-4 py-2 rounded-full font-bold">Frage {round+1}/{room.questions.length} · {question.d}</span><span className={`text-3xl font-black ${time<=5?'text-red-400 animate-pulse':'text-cyan-300'}`}>{time}s</span></div><div className="h-3 bg-white/10 rounded-full overflow-hidden mb-5"><motion.div className="h-full bg-gradient-to-r from-cyan-400 to-violet-500" animate={{width:`${time/15*100}%`}}/></div><div className="bg-white/10 rounded-[2rem] p-6 md:p-10 border border-white/10"><h2 className="text-2xl md:text-4xl font-black text-center min-h-28 flex items-center justify-center">{question.q}</h2><div className="grid md:grid-cols-2 gap-3 mt-6">{question.a.map((x,i)=><button key={x} disabled={locked} onClick={()=>submit(i)} className={`p-5 rounded-2xl text-left font-bold text-lg transition hover:scale-[1.02] disabled:cursor-default ${locked&&i===question.c?'bg-emerald-500 text-slate-950':locked&&selected===i?'bg-red-500':selected===i?'bg-cyan-400 text-slate-950':'bg-white/10 hover:bg-white/20'}`}><span className="opacity-60 mr-3">{String.fromCharCode(65+i)}</span>{x}</button>)}</div>{locked&&<div className="mt-5 flex flex-col sm:flex-row items-center justify-between gap-4 bg-black/20 rounded-2xl p-4"><div className="flex items-center gap-4"><Avatar p={me} size="text-5xl" mood={mood}/><div><div className="font-black">{selected===question.c?'Richtig! 🎉':`Richtig ist: ${question.a[question.c]}`}</div><div className="text-sm text-slate-300">Warte auf die Mitspieler.</div></div></div>{host&&<div className="flex gap-2"><Btn ghost onClick={scoreRound}>Punkte berechnen</Btn><Btn onClick={next}>Weiter</Btn></div>}</div>}</div></section><aside className="bg-white/10 rounded-[2rem] p-5 border border-white/10"><h3 className="font-black flex gap-2"><Trophy className="text-yellow-300"/> Rangliste</h3><div className="space-y-3 mt-5">{ranking.map((p,i)=><div key={p.id} className="flex items-center gap-3 bg-black/20 rounded-xl p-3"><span className="font-black text-xl w-6">{i+1}</span><Avatar p={p} size="text-3xl"/><div className="min-w-0"><div className="font-bold truncate">{p.name}</div><div className="text-cyan-300 text-sm">{p.score} Punkte</div></div></div>)}</div></aside></div>}
  {screen==="result"&&<section className="text-center bg-white/10 rounded-[2rem] p-8 border border-white/10"><Trophy className="mx-auto text-yellow-300 w-16 h-16"/><h2 className="text-4xl font-black mt-3">Das Rennen ist beendet!</h2><div className="flex justify-center my-8"><Avatar p={ranking[0]||me} mood="win"/></div><div className="text-2xl font-black text-yellow-300 mb-7">{ranking[0]?.name} gewinnt mit {ranking[0]?.score||0} Punkten!</div><div className="max-w-xl mx-auto space-y-3">{ranking.map((p,i)=><div className="flex items-center justify-between bg-black/20 rounded-2xl p-4" key={p.id}><div className="flex items-center gap-3"><span className="text-2xl font-black">#{i+1}</span><Avatar p={p} size="text-4xl" mood={i===0?'win':'sad'}/><span className="font-bold">{p.name}</span></div><b>{p.score}</b></div>)}</div><div className="mt-8"><Btn onClick={()=>location.reload()}><span className="inline-flex gap-2"><RotateCcw/> Neues Spiel</span></Btn></div></section>}
  <footer className="text-center text-xs text-slate-400 mt-8">Lokaler Multiplayer-Prototyp · Öffne die Seite in mehreren Tabs/Fenstern desselben Browsers und nutze denselben Raumcode.</footer>
