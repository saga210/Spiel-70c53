   <label className="text-sm font-bold">Spielername</label><input value={name} onChange={e=>setName(e.target.value)} placeholder="Dein Name" className="w-full mt-2 mb-5 bg-slate-950/70 border border-white/15 rounded-2xl px-4 py-3 outline-none focus:border-cyan-300"/>
