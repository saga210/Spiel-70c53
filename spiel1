function Avatar({p,size="text-6xl",mood="normal"}){
 const face=mood==="sad"?"🥺":p.animal;
 return <motion.div animate={mood==="win"?{rotate:[0,-12,12,-12,12,0],y:[0,-12,0,-12,0]}:mood==="sad"?{y:[0,5,0]}:{y:[0,-2,0]}} transition={{repeat:mood==="win"?Infinity:0,duration:mood==="win"?1.1:.5}} className="relative inline-flex flex-col items-center select-none">
   <span className="text-2xl -mb-3 z-10">{p.hair}</span><span className={size}>{face}</span><span className="text-3xl -mt-3">{p.clothes}</span>{p.accessory!=="Ohne"&&<span className="absolute -right-3 top-8 text-3xl">{p.accessory}</span>}
 </motion.div>
}

export default function App(){
 const [screen,setScreen]=useState("home"),[name,setName]=useState(""),[code,setCode]=useState("");
 const [me,setMe]=useState({id:uid(),name:"",animal:"🦊",hair:"✨",clothes:"👕",accessory:"Ohne",score:0});
 const [room,setRoom]=useState(null),[players,setPlayers]=useState([]),[host,setHost]=useState(false);
 const [round,setRound]=useState(0),[selected,setSelected]=useState(null),[locked,setLocked]=useState(false),[time,setTime]=useState(15),[answers,setAnswers]=useState({}),[mood,setMood]=useState("normal");
 const channel=useRef(null),startAt=useRef(0);
 const question=room?.questions?.[round];
 const post=(type,data={})=>channel.current?.postMessage({type,data,from:me.id,at:Date.now()});
 const savePlayers=ps=>{setPlayers(ps);localStorage.setItem(`wr-${room?.code||code}`,JSON.stringify(ps));};

 useEffect(()=>()=>channel.current?.close(),[]);
 useEffect(()=>{
   if(screen!=="game"||locked||!question)return;
   const t=setInterval(()=>setTime(x=>{if(x<=1){clearInterval(t);submit(-1);return 0}return x-1}),1000);return()=>clearInterval(t);
 },[screen,round,locked,question]);

 function connect(rc,isHost){
   channel.current?.close(); channel.current=new BroadcastChannel(`wissens-race-${rc}`);
   channel.current.onmessage=e=>handle(e.data,rc,isHost);
 }
 function handle(msg,rc,isHost){
   const {type,data}=msg;
   if(type==="join"&&isHost){setPlayers(ps=>{const n=ps.some(x=>x.id===data.id)?ps:[...ps,data];localStorage.setItem(`wr-${rc}`,JSON.stringify(n));post("state",{players:n,room:JSON.parse(localStorage.getItem(`room-${rc}`))});return n})}
   if(type==="state"){setPlayers(data.players);if(data.room){setRoom(data.room);setScreen(data.room.status==="game"?"game":"lobby")}}
   if(type==="start"){setRoom(data);setRound(0);setScreen("game");setTime(15);setLocked(false);setAnswers({});startAt.current=Date.now()}
   if(type==="answer"&&isHost)setAnswers(a=>({...a,[data.id]:data}));
   if(type==="scores"){setPlayers(data.players);setLocked(true);setMood(data.correctIds.includes(me.id)?"normal":"sad")}
   if(type==="next"){if(data.done){setPlayers(data.players);setScreen("result")}else{setPlayers(data.players);setRound(data.round);setSelected(null);setLocked(false);setAnswers({});setMood("normal");setTime(15);startAt.current=Date.now()}}
 }
